<?xml version="1.0" encoding="utf-8"?>
<!-- Template: scripts\build-msix.ps1 fills the __PLACEHOLDERS__ from store-identity.json. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Invisipal</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Private meeting notes and teleprompter, hidden from screen sharing.</Description>
  </Properties>

  <Dependencies>
    <!-- WDA_EXCLUDEFROMCAPTURE needs Windows 10 version 2004 (build 19041) or newer. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es" />
  </Resources>

  <Applications>
    <Application Id="Invisipal" Executable="Invisipal\Invisipal.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Invisipal"
        Description="Private meeting notes and teleprompter, hidden from screen sharing."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A regular desktop (Win32) app: global hotkeys, display affinity, Documents access. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
